<nav class="app-navbar navbar navbar-expand">
  <div class="container-fluid">
    <a class="app-brand" href="<%= JSON.parse(routes).root %>">
      <span class="brand-mark"><i class="bi bi-calendar2-check"></i></span>
      <span>
        <span class="d-block lh-1">Crontab UI</span>
        <span class="brand-version">Scheduler</span>
      </span>
    </a>

    <div class="navbar-actions">
      <div class="dropdown">
        <button class="nav-control dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-clock-history"></i>
          <span class="d-none d-sm-inline">Backups</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <% if (backups.length == 0) { %>
            <li><span class="dropdown-item-text text-body-secondary small">No backups yet</span></li>
          <% } else { %>
            <% backups.forEach(function(file) { %>
              <li>
                <a class="dropdown-item" href="<%= JSON.parse(routes).restore %>?db=<%= encodeURIComponent(file) %>">
                  <i class="bi bi-file-earmark-zip me-2"></i><%= file %>
                </a>
              </li>
            <% }) %>
          <% } %>
        </ul>
      </div>
      <button class="nav-control" type="button" id="theme-toggle" aria-label="Toggle color theme" title="Toggle color theme">
        <i class="bi bi-moon-stars" id="theme-icon"></i>
      </button>
      <a class="nav-control" href="https://github.com/alseambusher/crontab-ui" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="View on GitHub">
        <i class="bi bi-github"></i>
      </a>
    </div>
  </div>
</nav>
