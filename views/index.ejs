<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Cronjobs · Crontab UI</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/modern.css" rel="stylesheet">
<script>
  (function() {
    var savedTheme = localStorage.getItem('crontab-ui-theme');
    var theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-bs-theme', theme);
  })();
</script>
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="script.js"></script>
<script src="mailconfig.js"></script>
<script type="text/javascript">
	var crontabs = [];
	var routes = [];
	var serverMailConfigured = <%= serverMailConfigured %>;
	document.addEventListener('DOMContentLoaded', function() {
		var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
		tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
		crontabs = JSON.parse('<%- crontabs.replace(/\\\\/g, "\\\\\\\\").replace(/\\\"/g,"\\\\\"").replace(/\'/g,"\\\'").replace(/\\t/g, " ") %>');
		routes = JSON.parse('<%- routes %>');
		$("#env_vars").val(`<%- env %>`);
		initThemeToggle();
	});
</script>
</head>
<body class="app-body">
<% const jobs = JSON.parse(crontabs); %>
<% const activeJobs = jobs.filter(function(job) { return !job.stopped; }).length; %>
<% const pausedJobs = jobs.length - activeJobs; %>
<%
	const categorySeparator = ' · ';
	const jobGroups = jobs.reduce(function(groups, job) {
		const category = job.name && job.name.includes(categorySeparator)
			? job.name.split(categorySeparator)[0].trim()
			: 'Other jobs';
		if (!groups[category]) groups[category] = [];
		groups[category].push(job);
		return groups;
	}, {});
	const categories = Object.keys(jobGroups).sort(function(a, b) {
		return a.localeCompare(b, 'zh-CN');
	});
	categories.forEach(function(category) {
		jobGroups[category].sort(function(a, b) {
			return String(a.name || '').localeCompare(String(b.name || ''), 'zh-CN');
		});
	});
%>
<%- include('navbar.ejs') -%>

<main class="page-shell">
	<header class="page-heading">
		<div>
			<div class="eyebrow">Task scheduler</div>
			<h1 class="page-title">Cronjobs</h1>
			<p class="page-description">Create, pause, inspect and deploy scheduled tasks from one place.</p>
		</div>
		<button class="btn btn-primary" type="button" onclick="newJob();">
			<i class="bi bi-plus-lg me-1"></i> New job
		</button>
	</header>

	<section class="summary-grid" aria-label="Job overview">
		<div class="summary-card">
			<span class="summary-icon"><i class="bi bi-calendar3"></i></span>
			<div><div class="summary-value"><%= jobs.length %></div><div class="summary-label">Total jobs</div></div>
		</div>
		<div class="summary-card">
			<span class="summary-icon success"><i class="bi bi-play-fill"></i></span>
			<div><div class="summary-value"><%= activeJobs %></div><div class="summary-label">Active</div></div>
		</div>
		<div class="summary-card">
			<span class="summary-icon warning"><i class="bi bi-pause-fill"></i></span>
			<div><div class="summary-value"><%= pausedJobs %></div><div class="summary-label">Paused</div></div>
		</div>
	</section>

	<section class="panel environment-panel">
		<button class="panel-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#environment-body" aria-expanded="false" aria-controls="environment-body">
			<span class="panel-toggle-copy">
				<i class="bi bi-braces-asterisk"></i>
				<span><strong>Environment variables</strong><small>Shared values written above the generated crontab</small></span>
			</span>
			<i class="bi bi-chevron-down chevron"></i>
		</button>
		<div class="collapse" id="environment-body">
			<div class="environment-body">
				<label for="env_vars" class="visually-hidden">Environment variables</label>
				<textarea class="form-control" rows="4" id="env_vars" placeholder="# PATH, MAILTO, HOME and other shared variables"></textarea>
			</div>
		</div>
	</section>

	<div class="toolbar" aria-label="Crontab actions">
		<div class="toolbar-group">
			<button class="btn btn-surface" type="button" onclick="getCrontab();" data-bs-toggle="tooltip" title="Import the currently installed crontab">
				<i class="bi bi-arrow-down-circle me-1"></i> Pull from crontab
			</button>
			<button class="btn btn-primary" type="button" onclick="setCrontab();">
				<i class="bi bi-cloud-arrow-up me-1"></i> Deploy changes
			</button>
			<button class="btn btn-surface" type="button" onclick="previewCrontab();">
				<i class="bi bi-code-square me-1"></i> Preview
			</button>
		</div>
		<div class="toolbar-group">
			<button class="btn btn-surface" type="button" onclick="doBackup();"><i class="bi bi-shield-check me-1"></i> Backup</button>
			<div class="dropdown">
				<button class="btn btn-surface dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
					<i class="bi bi-three-dots me-1"></i> More
				</button>
				<ul class="dropdown-menu dropdown-menu-end">
					<li><button class="dropdown-item" type="button" onclick="import_db()"><i class="bi bi-box-arrow-in-down me-2"></i>Import database</button></li>
					<li><a class="dropdown-item" href="<%= JSON.parse(routes).export %>"><i class="bi bi-box-arrow-up me-2"></i>Export database</a></li>
				</ul>
			</div>
		</div>
	</div>

	<form id="import_form" enctype="multipart/form-data" action="<%= JSON.parse(routes).import %>" method="post" hidden>
		<input type="file" id="import_file" name="import_file" onchange="$('#import_form').submit()">
	</form>

	<section class="job-browser" aria-labelledby="scheduled-jobs-heading">
		<div class="job-browser-header">
			<div>
				<h2 id="scheduled-jobs-heading">Scheduled jobs</h2>
				<p><span id="visible-job-count"><%= jobs.length %></span> jobs across <%= categories.length %> categories</p>
			</div>
			<label class="job-search">
				<i class="bi bi-search"></i>
				<span class="visually-hidden">Search jobs</span>
				<input type="search" id="job-search" placeholder="Search jobs…" oninput="filterJobTables(this.value)" autocomplete="off">
			</label>
		</div>

		<% if (jobs.length === 0) { %>
			<div class="panel empty-state-panel">
				<div class="empty-state"><i class="bi bi-calendar2-plus"></i>No scheduled jobs yet</div>
			</div>
		<% } else { %>
			<div class="category-stack">
			<% categories.forEach(function(category) { %>
				<section class="panel table-panel category-panel" data-category="<%= category %>">
					<div class="category-header">
						<div class="category-title">
							<span class="category-icon"><i class="bi bi-folder2"></i></span>
							<div>
								<h3><%= category %></h3>
								<p><span class="category-visible-count"><%= jobGroups[category].length %></span> jobs</p>
							</div>
						</div>
						<span class="category-count"><%= jobGroups[category].length %></span>
					</div>
					<div class="table-responsive">
						<table class="table job-table">
							<thead>
								<tr>
									<th>Status</th>
									<th>Name</th>
									<th>Command</th>
									<th>Schedule</th>
									<th>Modified</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
							<% jobGroups[category].forEach(function(crontab) { %>
								<%
									const displayName = crontab.name && crontab.name.includes(categorySeparator)
										? crontab.name.split(categorySeparator).slice(1).join(categorySeparator).trim()
										: (crontab.name || 'Untitled job');
									const searchText = [
										category,
										crontab.name,
										crontab.command,
										crontab.schedule,
										crontab.human
									].filter(Boolean).join(' ').toLocaleLowerCase('zh-CN');
								%>
								<tr class="job-row" data-search="<%= searchText %>">
									<td>
										<% if (!crontab.stopped) { %><span class="status-badge status-active">Active</span><% } else { %><span class="status-badge status-paused">Paused</span><% } %>
									</td>
									<td>
										<span class="job-name"><%= displayName %></span>
										<span class="job-id" title="<%= crontab._id %>"><%= crontab._id %></span>
										<% if (crontab.saved) { %>
											<span class="deploy-state saved"><i class="bi bi-check2-circle"></i> Deployed</span>
										<% } else { %>
											<span class="deploy-state unsaved"><i class="bi bi-exclamation-circle"></i> Pending deploy</span>
										<% } %>
									</td>
									<td><code class="command-code" title="<%= crontab.command %>"><%= crontab.command %></code></td>
									<td>
										<span class="schedule-code" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Next: <%= crontab.next %>"><%= crontab.schedule %></span>
										<span class="schedule-human"><%= crontab.human %></span>
									</td>
									<td><span class="modified-date" title="<%= crontab.timestamp %>"><%= dayjs(new Date(crontab.timestamp)).fromNow() %></span></td>
									<td>
										<div class="action-list">
										<% if (!crontab.stopped) { %>
											<% if (crontab.logging && crontab.logging != 'false') { %>
												<a class="icon-button danger" data-bs-toggle="tooltip" title="Error log" href="<%= JSON.parse(routes).logger + '?id=' + crontab._id %>" target="_blank"><i class="bi bi-exclamation-square"></i></a>
												<a class="icon-button" data-bs-toggle="tooltip" title="Output log" href="<%= JSON.parse(routes).stdout + '?id=' + crontab._id %>" target="_blank"><i class="bi bi-terminal"></i></a>
											<% } %>
											<button class="icon-button primary" type="button" data-bs-toggle="tooltip" title="Run now" onclick="runJob('<%= crontab._id %>')"><i class="bi bi-play-fill"></i></button>
											<button class="icon-button" type="button" data-bs-toggle="tooltip" title="Edit" onclick="editJob('<%= crontab._id %>')"><i class="bi bi-pencil"></i></button>
											<button class="icon-button" type="button" data-bs-toggle="tooltip" title="Pause" onclick="stopJob('<%= crontab._id %>')"><i class="bi bi-pause-fill"></i></button>
										<% } else { %>
											<button class="icon-button primary" type="button" data-bs-toggle="tooltip" title="Enable" onclick="startJob('<%= crontab._id %>')"><i class="bi bi-play-circle"></i></button>
										<% } %>
											<button class="icon-button" type="button" data-bs-toggle="tooltip" title="Duplicate" onclick="duplicateJob('<%= crontab._id %>')"><i class="bi bi-copy"></i></button>
											<button class="icon-button danger" type="button" data-bs-toggle="tooltip" title="Delete" onclick="deleteJob('<%= crontab._id %>')"><i class="bi bi-trash3"></i></button>
										</div>
									</td>
								</tr>
							<% }); %>
							</tbody>
						</table>
					</div>
				</section>
			<% }); %>
			</div>
			<div class="panel empty-state-panel" id="no-search-results" hidden>
				<div class="empty-state"><i class="bi bi-search"></i>No jobs match your search</div>
			</div>
		<% } %>
	</section>
</main>

<%- include('popup.ejs') -%>
</body>
</html>
