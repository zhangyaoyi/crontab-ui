<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Backup · Crontab UI</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/modern.css" rel="stylesheet">
<script>
  (function() {
    var savedTheme = localStorage.getItem('crontab-ui-theme');
    var theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-bs-theme', theme);
  })();
</script>
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="script.js"></script>
<script type="text/javascript">
	var crontabs = [];
	var routes = [];
	document.addEventListener('DOMContentLoaded', function() {
		crontabs = JSON.parse('<%- crontabs.replace(/\\\\/g, "\\\\\\\\").replace(/\\\"/g,"\\\\\"").replace(/\'/g,"\\\'") %>');
		routes = JSON.parse('<%- routes %>');
		initThemeToggle();
	});
</script>
</head>
<body class="app-body">
<% const jobs = JSON.parse(crontabs); %>
<%- include('navbar.ejs') -%>

<main class="page-shell">
	<div class="restore-header">
		<div>
			<div class="eyebrow">Backup snapshot</div>
			<h1 class="page-title"><%= db %></h1>
			<p class="page-description"><%= jobs.length %> jobs stored in this backup. Review them before restoring.</p>
		</div>
		<a class="btn btn-surface" href="<%= JSON.parse(routes).root %>"><i class="bi bi-arrow-left me-1"></i> Back to jobs</a>
	</div>

	<section class="panel table-panel mb-3">
		<div class="table-panel-header">
			<div><h2>Backup contents</h2><p>This view is read-only.</p></div>
		</div>
		<div class="table-responsive">
			<table class="table">
				<thead><tr><th>Status</th><th>Name</th><th>Command</th><th>Schedule</th><th>Modified</th></tr></thead>
				<tbody>
				<% jobs.forEach(function(crontab) { %>
					<tr>
						<td><% if (!crontab.stopped) { %><span class="status-badge status-active">Active</span><% } else { %><span class="status-badge status-paused">Paused</span><% } %></td>
						<td><span class="job-name"><%= crontab.name || 'Untitled job' %></span><span class="job-id" title="<%= crontab._id %>"><%= crontab._id %></span></td>
						<td><code class="command-code" title="<%= crontab.command %>"><%= crontab.command %></code></td>
						<td><span class="schedule-code"><%= crontab.schedule %></span></td>
						<td><span class="modified-date"><%= crontab.timestamp %></span></td>
					</tr>
				<% }); %>
				</tbody>
			</table>
		</div>
	</section>

	<div class="d-flex flex-wrap justify-content-end gap-2">
		<button class="btn btn-danger-soft" type="button" onclick="delete_backup('<%= db %>')"><i class="bi bi-trash3 me-1"></i> Delete backup</button>
		<button class="btn btn-primary" type="button" onclick="restore_backup('<%= db %>')"><i class="bi bi-arrow-counterclockwise me-1"></i> Restore this backup</button>
	</div>
</main>

<%- include('popup.ejs') -%>
</body>
</html>
